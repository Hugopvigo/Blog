---
import { Prism } from "@astrojs/prism";
import TermWindow from "./TermWindow.astro";

export interface Props {
  snippet: { file: string; lang: string; code: string };
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { snippet, size = "md", class: className, ...rest } = Astro.props;
---

<TermWindow
  title={snippet.file}
  variant="code"
  size={size}
  class={className}
  {...rest}
>
  <div class:list={["term-code", "snippet__code", `snippet__code--${size}`]}>
    <Prism lang={snippet.lang} code={snippet.code} />
  </div>
</TermWindow>

<style>
  .snippet__code {
    white-space: pre;
  }

  .snippet__code--sm {
    font-size: 13px;
    line-height: 1.7;
    overflow: hidden;
  }

  .snippet__code--md {
    font-size: 14px;
    line-height: 1.75;
    overflow: hidden;
  }

  .snippet__code--lg {
    font-size: 15px;
    line-height: 1.8;
    overflow-x: auto;
  }

  /*
    En móvil, un fragmento que se corta a media línea queda mal: se deja
    desplazable en horizontal en lugar de esconderlo.
  */
  @media (max-width: 620px) {
    .snippet__code--sm,
    .snippet__code--md {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
</style>
