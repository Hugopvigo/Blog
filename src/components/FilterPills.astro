---
export interface Props {
  options: { value: string; label: string }[];
  label: string;
}

const { options, label } = Astro.props;
---

<div class="filter-pills" role="group" aria-label={label}>
  {
    options.map((option) => (
      <button
        type="button"
        class="pill"
        data-filter-pill={option.value}
        aria-pressed={option.value === "*" ? "true" : "false"}
      >
        {option.label}
      </button>
    ))
  }
</div>

<style>
  .filter-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill {
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .pill:hover {
    border-color: var(--a);
    color: var(--a);
  }

  .pill[aria-pressed="true"] {
    background: var(--a);
    border-color: var(--a);
    color: var(--inv);
    font-weight: 700;
  }
</style>
