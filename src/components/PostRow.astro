---
import type { CollectionEntry } from "astro:content";
import Snippet from "./Snippet.astro";
import { formatDate } from "../config";
import {
  getReadingTime,
  normalize,
  postHref,
  resolveSnippet,
} from "../lib/content-utils";

export interface Props {
  post: CollectionEntry<"blog">;
  number?: string;
  variant: "home" | "list" | "related";
  hidden?: boolean;
}

const { post, number, variant, hidden = false } = Astro.props;
const { title, tag, date } = post.data;
const href = postHref(post);
const formatted = formatDate(date);
const readingTime = getReadingTime(post.body ?? "");
const search = normalize(`${title} ${tag ?? ""}`);
const external = post.data.external === true;
---

{/*
  La fila tiene dos hijos: el enlace (que es la fila entera, con su rejilla) y
  la previsualización del fragmento, que va FUERA del enlace.

  Así el contenido del enlace es solo texto y el nombre accesible es
  exactamente el título del post: el código no aporta nada al enlace, ni al
  nombre accesible ni al árbol de accesibilidad. El contenedor es el que
  posiciona la previsualización, que es decorativa (`aria-hidden`).
*/}
<div
  class:list={["post-row-wrap", `post-row-wrap--${variant}`]}
  data-filter-item
  data-tag={tag ?? ""}
  data-search={search}
  data-year={date.getFullYear()}
  hidden={hidden}
>
  <a
    href={href}
    class:list={["post-row", `post-row--${variant}`]}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >
    {number && (
      <span class="post-row__number" aria-hidden="true">
        {number}
      </span>
    )}

    <span class="post-row__title">
      {title}
      {external && <span class="post-row__external" aria-hidden="true">↗</span>}
    </span>

    {variant === "related" ? (
      <span class="post-row__aside post-row__aside--related" aria-hidden="true">
        {formatted} <span aria-hidden="true">→</span>
      </span>
    ) : (
      <span class="post-row__aside" aria-hidden="true">
        {tag && <span class="post-row__tag">#{tag}</span>}
        <span>{formatted}</span>
        <span>{readingTime} min</span>
      </span>
    )}
  </a>

  {variant !== "related" && (
    <div class="post-row__peek" aria-hidden="true">
      <Snippet snippet={resolveSnippet(post)} size="sm" />
    </div>
  )}
</div>

<style>
  /*
    Contenedor de la fila: sostiene la previsualización, que es hermana del
    enlace y no forma parte de él.
  */
  .post-row-wrap {
    position: relative;
  }

  .post-row {
    display: grid;
    align-items: baseline;
    column-gap: 20px;
    row-gap: 8px;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.2s, color 0.2s;
  }

  /* Título arriba y, debajo, una sola línea con etiqueta · fecha · lectura. */
  .post-row--home {
    grid-template-columns: 48px minmax(0, 1fr);
    padding: clamp(18px, 2.4vw, 28px) clamp(20px, 4vw, 40px);
  }

  .post-row--list {
    grid-template-columns: minmax(0, 1fr);
    padding: clamp(18px, 2.4vw, 26px) clamp(20px, 4vw, 40px);
  }

  .post-row--related {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    padding: clamp(18px, 2.4vw, 26px) clamp(20px, 4vw, 40px);
  }

  .post-row__number {
    grid-row: 1 / span 2;
    font-size: 14px;
    color: var(--mut);
  }

  .post-row__title {
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .post-row--home .post-row__title {
    font-size: clamp(20px, 2.6vw, 34px);
    max-width: 46ch;
  }

  .post-row--list .post-row__title {
    font-size: clamp(20px, 2.4vw, 30px);
    max-width: 48ch;
  }

  .post-row--related .post-row__title {
    font-size: clamp(20px, 2.4vw, 28px);
  }

  .post-row__external {
    color: var(--a);
  }

  .post-row__aside {
    font-size: 14px;
    color: var(--mut);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .post-row__aside > span:not(:first-child)::before {
    content: "· ";
  }

  .post-row__aside--related {
    gap: 8px;
  }

  .post-row__tag {
    color: var(--fg);
    font-weight: 700;
  }

  /* La previsualización solo existe con ratón y pantalla ancha. */
  .post-row__peek {
    display: none;
  }

  .post-row:hover,
  .post-row:focus-visible {
    background: var(--a);
    color: var(--inv);
  }

  .post-row:focus-visible {
    outline: 2px solid var(--a);
    outline-offset: 2px;
  }

  .post-row:hover .post-row__aside,
  .post-row:focus-visible .post-row__aside,
  .post-row:hover .post-row__tag,
  .post-row:focus-visible .post-row__tag,
  .post-row:hover .post-row__number,
  .post-row:focus-visible .post-row__number {
    color: var(--inv);
  }

  /* Sobre el fondo de acento la flecha del enlace externo no se vería. */
  .post-row:hover .post-row__external,
  .post-row:focus-visible .post-row__external {
    color: var(--inv);
  }

  /* Estas filas llevan los metadatos DEBAJO del título, en la columna del
     título (la del número, en la portada, queda libre a su izquierda). */
  .post-row--home .post-row__aside {
    grid-column: 2;
  }

  @media (max-width: 620px) {
    .post-row--related {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }

    .post-row--home .post-row__title,
    .post-row--list .post-row__title {
      max-width: none;
    }
  }

  @media (hover: hover) and (min-width: 900px) {
    /*
      Al pasar el ratón por la fila (o al enfocarla) sale la previsualización,
      pegada al borde derecho; el título deja libre esa franja (380 px del
      fragmento + el margen) para que no lo tape.
    */
    .post-row--home .post-row__title,
    .post-row--list .post-row__title {
      max-width: min(48ch, calc(100% - 440px));
    }

    .post-row-wrap:hover .post-row__peek,
    .post-row:focus-visible ~ .post-row__peek {
      display: block;
      position: absolute;
      right: clamp(20px, 4vw, 40px);
      top: 50%;
      width: 380px;
      transform: translateY(-50%) rotate(3deg);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
      pointer-events: none;
      z-index: 3;
    }
  }
</style>
