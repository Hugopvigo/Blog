---
import type { CollectionEntry } from "astro:content";
import Snippet from "./Snippet.astro";
import {
  formatDate,
} from "../config";
import {
  getReadingTime,
  normalize,
  postHref,
  resolveSnippet,
} from "../lib/content-utils";

export interface Props {
  post: CollectionEntry<"blog">;
  number?: string;
  variant: "home" | "list" | "related";
  hidden?: boolean;
}

const { post, number, variant, hidden = false } = Astro.props;
const { title, tag, date } = post.data;
const href = postHref(post);
const formatted = formatDate(date);
const readingTime = getReadingTime(post.body ?? "");
const search = normalize(`${title} ${tag ?? ""}`);
const external = post.data.external === true;
---

<a
  href={href}
  class:list={["post-row", `post-row--${variant}`]}
  data-filter-item
  data-tag={tag ?? ""}
  data-search={search}
  data-year={date.getFullYear()}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  hidden={hidden}
>
  {number && <span class="post-row__number">{number}</span>}

  <span class="post-row__title">
    {title}
    {external && <span class="post-row__external" aria-hidden="true">↗</span>}
  </span>

  {
    variant === "related" ? (
      <span class="post-row__aside post-row__aside--related">
        {formatted} <span aria-hidden="true">→</span>
      </span>
    ) : (
      <span class="post-row__aside">
        {tag && <span class="post-row__tag">#{tag}</span>}
        <span class="post-row__date">
          {formatted}
          {variant === "list" && <span class="post-row__read"> · {readingTime} min</span>}
        </span>
      </span>
    )
  }

  {
    variant !== "related" && (
      <span class="post-row__peek" aria-hidden="true">
        <Snippet snippet={resolveSnippet(post)} size="sm" />
      </span>
    )
  }
</a>

<style>
  .post-row {
    position: relative;
    display: grid;
    align-items: center;
    gap: 20px;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.2s, color 0.2s;
  }

  .post-row--home {
    grid-template-columns: 48px minmax(0, 1fr) auto;
    padding: clamp(18px, 2.4vw, 28px) clamp(20px, 4vw, 40px);
  }

  .post-row--list {
    grid-template-columns: minmax(0, 1fr) auto;
    padding: clamp(14px, 1.8vw, 20px) 0;
  }

  .post-row--related {
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 14px 0;
  }

  .post-row__number {
    font-size: 14px;
  }

  .post-row__title {
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }

  .post-row--home .post-row__title {
    font-size: clamp(20px, 2.6vw, 34px);
    max-width: 26ch;
  }

  .post-row--list .post-row__title {
    font-size: clamp(20px, 2.4vw, 30px);
    max-width: 30ch;
  }

  .post-row--related .post-row__title {
    font-size: clamp(20px, 2.4vw, 28px);
  }

  .post-row__external {
    color: var(--a);
  }

  .post-row__aside {
    font-size: 13px;
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-row__aside--related {
    flex-direction: row;
    gap: 8px;
    color: var(--mut);
  }

  .post-row__tag {
    color: var(--fg);
  }

  .post-row__date {
    opacity: 0.7;
  }

  .post-row__read {
    opacity: 1;
  }

  /* La previsualización solo existe con ratón y pantalla ancha. */
  .post-row__peek {
    display: none;
  }

  .post-row:hover,
  .post-row:focus-visible {
    background: var(--a);
    color: var(--inv);
  }

  .post-row:focus-visible {
    outline: 2px solid var(--a);
    outline-offset: 2px;
  }

  .post-row:hover .post-row__tag,
  .post-row:focus-visible .post-row__tag {
    color: var(--inv);
  }

  @media (hover: hover) and (min-width: 900px) {
    .post-row:hover .post-row__peek,
    .post-row:focus-visible .post-row__peek {
      display: block;
      position: absolute;
      right: 18%;
      top: 50%;
      width: 360px;
      transform: translateY(-50%) rotate(4deg);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
      pointer-events: none;
      z-index: 3;
    }

    .post-row--list .post-row__peek {
      right: 20%;
    }
  }
</style>
