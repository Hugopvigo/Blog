---
import type { HTMLTag } from "astro/types";

interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  id?: string;
}

const { level, id } = Astro.props;
// El título de la página es el único <h1>: un `#` en el cuerpo del post se
// renderiza como <h2> para no invertir la jerarquía.
const Tag = `h${level === 1 ? 2 : level}` as HTMLTag;
// Prefijo de terminal: «## » para los h2, «### » para los h3… (el espacio va
// dentro del prefijo: Astro quita el salto de línea de la plantilla).
const prefix = level >= 2 ? `${"#".repeat(level)} ` : "## ";
---

<Tag id={id} class="post-heading">
  {prefix && <span class="post-heading__prefix" aria-hidden="true">{prefix}</span>}
  <slot />
</Tag>

<style>
  /* La tipografía de los encabezados la fija el cuerpo del artículo
     (`.article-body`), aquí solo el prefijo. */
  .post-heading__prefix {
    color: var(--a);
  }
</style>
