---
import { Prism } from "@astrojs/prism";
import TermWindow from "./TermWindow.astro";

const { language, content } = Astro.props;
---

<TermWindow title={language || "txt"} variant="code" size="lg" copy>
  <div class="term-code code-block">
    {
      language ? (
        <Prism lang={language} code={content} />
      ) : (
        <pre><code>{content}</code></pre>
      )
    }
  </div>
</TermWindow>

<style>
  /* El cuerpo del artículo marca 19 px; el bloque de código va a 15 px. */
  .code-block {
    font-size: 15px;
    line-height: 1.8;
  }
</style>
