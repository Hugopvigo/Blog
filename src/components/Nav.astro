---
const links = [
  { href: "/", label: "./inicio" },
  { href: "/blog", label: "./blog" },
  { href: "/projects", label: "./proyectos" },
];

// Misma lógica de activo que el HeaderLink de la plantilla: la portada solo
// está activa en "/" y el resto de secciones, en sus subrutas.
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) =>
  href === "/" ? path === "" : path.substring(1).startsWith(href.substring(1));
---

<ul class="unset nav-links">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={["nav-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--a);
  }

  .nav-link.is-active {
    color: var(--a);
  }
</style>
