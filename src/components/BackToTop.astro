---

<button id="back-to-top" aria-label="Volver arriba" title="Volver arriba">
  <span aria-hidden="true">↑</span> arriba
</button>

<style>
  #back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--a);
    background-color: var(--bg);
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    z-index: 50;
  }

  #back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (max-width: 48rem) {
    #back-to-top {
      display: none;
    }
  }
</style>

<script>
  let backToTopScrollHandler: (() => void) | null = null;

  function initBackToTop() {
    if (backToTopScrollHandler) {
      window.removeEventListener("scroll", backToTopScrollHandler);
      backToTopScrollHandler = null;
    }

    const btn = document.getElementById("back-to-top");
    if (!btn) return;

    backToTopScrollHandler = () => {
      btn.classList.toggle("visible", window.scrollY > 300);
    };

    window.addEventListener("scroll", backToTopScrollHandler, { passive: true });
    backToTopScrollHandler();
    if (!btn.dataset.backToTopBound) {
      btn.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" })
      );
      btn.dataset.backToTopBound = "1";
    }
  }

  document.addEventListener("astro:page-load", initBackToTop);
  document.addEventListener("astro:before-swap", () => {
    if (backToTopScrollHandler) {
      window.removeEventListener("scroll", backToTopScrollHandler);
      backToTopScrollHandler = null;
    }
  });
</script>
