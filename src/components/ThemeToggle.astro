---
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="true">
  <span class="theme-toggle__icon" data-theme-icon aria-hidden="true">◐</span>
  <span class="theme-toggle__text" data-theme-label>modo claro</span>
</button>

<style>
  .theme-toggle {
    font: inherit;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 14px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  /* En móvil queda solo el icono; el texto sigue ahí para los lectores de
     pantalla (visualmente oculto, no `display: none`). */
  @media (max-width: 620px) {
    .theme-toggle {
      position: relative;
      width: 40px;
      padding: 0;
      justify-content: center;
    }

    .theme-toggle__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .theme-toggle:hover {
    border-color: var(--a);
    color: var(--a);
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    const label = btn.querySelector("[data-theme-label]");
    const icon = btn.querySelector("[data-theme-icon]");

    const paint = () => {
      const isDark = document.documentElement.classList.contains("dark");
      btn.setAttribute("aria-pressed", String(isDark));
      if (label) label.textContent = isDark ? "modo claro" : "modo oscuro";
      if (icon) icon.textContent = isDark ? "◐" : "◑";
    };

    paint();

    if (btn.dataset.themeBound) return;
    btn.dataset.themeBound = "1";

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const next = isDark ? "light" : "dark";

      document.documentElement.classList.toggle("dark", next === "dark");
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        /* sin localStorage el cambio dura lo que la página. */
      }

      const meta = document.head.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "dark" ? "#0e1214" : "#eef2ef");

      paint();
    });
  }

  document.addEventListener("astro:page-load", initThemeToggle);
</script>
