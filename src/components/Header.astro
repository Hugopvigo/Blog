---
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  promptPath: string;
  progress: boolean;
}

const { promptPath, progress } = Astro.props;
---

<a class="skip-link" href="#main">Saltar al contenido</a>

<header class="site-header" data-site-header>
  <nav class="container site-nav" aria-label="Navegación principal">
    <div class="traffic" aria-hidden="true">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>

    <a class="prompt-logo" href="/">
      <span class="logo-user">hugo</span><span class="logo-at">@</span
      ><span class="logo-name">perez-vigo</span
      ><span class="logo-path">:{promptPath}$</span>
    </a>

    <div class="nav-group">
      <Nav />
      <ThemeToggle />
    </div>
  </nav>

  {
    progress && (
      <div class="progress" aria-hidden="true">
        <div class="progress-bar" data-progress-bar></div>
      </div>
    )
  }
</header>

<style>
  .skip-link {
    position: absolute;
    left: 50%;
    top: -100rem;
    transform: translateX(-50%);
    z-index: 20;
    padding: 8px 18px;
    border-radius: 999px;
    background: var(--a);
    color: var(--inv);
    font-size: 14px;
    font-weight: 700;
  }

  .skip-link:focus {
    top: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .site-nav {
    padding-block: 14px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .traffic {
    display: flex;
    gap: 7px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot--red {
    background: #ff5f57;
  }

  .dot--yellow {
    background: #febc2e;
  }

  .dot--green {
    background: #28c840;
  }

  @media (max-width: 480px) {
    .traffic {
      display: none;
    }
  }

  .prompt-logo {
    margin-right: auto;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-user {
    color: var(--b);
  }

  .logo-at {
    color: var(--mut);
  }

  .logo-name {
    color: var(--a);
  }

  .logo-path {
    color: var(--mut);
  }

  .nav-group {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
  }

  .progress {
    height: 2px;
    background: transparent;
  }

  .progress-bar {
    height: 100%;
    width: 0;
    background: var(--a);
    box-shadow: 0 0 12px var(--a);
  }
</style>

<script>
  let headerObserver: ResizeObserver | null = null;
  let progressHandler: (() => void) | null = null;

  function initHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;

    if (headerObserver) headerObserver.disconnect();
    const update = () => {
      document.documentElement.style.setProperty(
        "--header-h",
        `${header.offsetHeight}px`
      );
    };
    update();
    headerObserver = new ResizeObserver(update);
    headerObserver.observe(header);
  }

  function initProgress() {
    const bar = document.querySelector<HTMLElement>("[data-progress-bar]");
    if (!bar) return;

    if (progressHandler) window.removeEventListener("scroll", progressHandler);
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
      bar.style.width = `${pct}%`;
    };
    progressHandler = update;
    window.addEventListener("scroll", progressHandler, { passive: true });
    update();
  }

  document.addEventListener("astro:page-load", () => {
    initHeader();
    initProgress();
  });

  document.addEventListener("astro:before-swap", () => {
    if (headerObserver) {
      headerObserver.disconnect();
      headerObserver = null;
    }
    if (progressHandler) {
      window.removeEventListener("scroll", progressHandler);
      progressHandler = null;
    }
  });
</script>
