---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../config";
import { urlHost } from "../lib/content-utils";

export interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, date, type, url } = project.data;
const host = urlHost(url);

// Las capturas las pone Hugo en src/assets/projects/ con el nombre del
// fichero del proyecto (el basename del .mdoc, en minúsculas).
const shots = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{webp,png,jpg}",
  { eager: true }
);
const base = (project.filePath.split("/").pop() ?? "")
  .replace(/\.mdoc$/, "")
  .toLowerCase();
const shot =
  shots[`/src/assets/projects/${base}.webp`] ??
  shots[`/src/assets/projects/${base}.png`] ??
  shots[`/src/assets/projects/${base}.jpg`];
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="project-card"
  data-filter-item
  data-tag={type}
  data-search={title}
>
  <span class="project-card__bar">
    <span class="project-card__dots" aria-hidden="true">
      <i class="dot dot--red"></i><i class="dot dot--yellow"></i
      ><i class="dot dot--green"></i>
    </span>
    <span class="project-card__host">{host}</span>
  </span>

  <span class="project-card__shot">
    {
      shot ? (
        <Image
          src={shot.default}
          alt={`Captura de ${title}`}
          widths={[400, 800]}
          sizes="(min-width: 900px) 300px, 90vw"
        />
      ) : (
        <span class="project-card__placeholder">
          <span class="project-card__dollar" aria-hidden="true">$</span> open{" "}
          {host}
        </span>
      )
    }
  </span>

  <span class="project-card__body">
    <span class="project-card__name">
      {title}
      <span class="project-card__arrow" aria-hidden="true">↗</span>
    </span>
    {description && <span class="project-card__desc">{description}</span>}
    <span class="project-card__meta">
      <span class="project-card__type">#{type}</span>
      <span class="project-card__date">{formatDate(date)}</span>
    </span>
  </span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg2);
    text-decoration: none;
    color: var(--fg);
    transition: transform 0.2s, border-color 0.2s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--a);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--a);
    outline-offset: 2px;
  }

  .project-card__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line);
  }

  .project-card__dots {
    display: flex;
    gap: 5px;
  }

  .project-card__dots .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot--red {
    background: #ff5f57;
  }

  .dot--yellow {
    background: #febc2e;
  }

  .dot--green {
    background: #28c840;
  }

  .project-card__host {
    margin-left: 6px;
    font-size: 11px;
    color: var(--mut);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card__shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
  }

  .project-card__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--bg);
    font-size: 13px;
    color: var(--mut);
  }

  .project-card__dollar {
    color: var(--b);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px 18px;
  }

  .project-card__name {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .project-card__arrow {
    color: var(--a);
  }

  .project-card__desc {
    font-size: 14px;
    color: var(--mut);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--mut);
  }

  .project-card__type {
    color: var(--b);
  }
</style>
