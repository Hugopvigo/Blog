---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="footer-copy"
      ><span class="dollar" aria-hidden="true">$</span> exit 0
      <span class="mut">— © {year} Hugo Perez-Vigo</span></span
    >
    <div class="footer-links">
      <a href="https://github.com/Hugopvigo" target="_blank" rel="noopener noreferrer"
        >github</a
      >
      <a
        href="https://twitter.com/hugopvigo"
        target="_blank"
        rel="noopener noreferrer">twitter</a
      >
      <a href="/rss.xml">rss</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    padding-block: 28px 40px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--mut);
  }

  .dollar {
    color: var(--b);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--a);
  }
</style>
