---
import type { Heading } from "../lib/content-utils";

interface Props {
  headings: Heading[];
  /**
   * Desplegable al principio del artículo, para cuando el índice lateral no
   * cabe (móvil, tablet y pantallas de menos de 1360 px).
   */
  inline?: boolean;
}

const { headings, inline = false } = Astro.props;
const visible = headings.filter((h) => h.depth <= 3);
---

{
  visible.length >= 2 && inline && (
    <details class="toc-inline">
      <summary class="toc-title toc-inline__summary">// contenidos</summary>
      <nav aria-label="Tabla de contenidos">
        <ol class="toc-list">
          {visible.map((h) => (
            <li style={`padding-left: ${(h.depth - 1) * 0.75}rem`}>
              <a href={`#${h.slug}`} class="toc-inline__link">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

{
  visible.length >= 2 && !inline && (
    <nav class="toc" aria-label="Tabla de contenidos">
      <p class="toc-title">// contenidos</p>
      <ol class="toc-list">
        {visible.map((h) => (
          <li style={`padding-left: ${(h.depth - 1) * 0.75}rem`}>
            <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    /*
      El contenido del artículo (el fragmento grande y las figuras anchas)
      mide 1040 px —la misma cifra que `--figure-width` en global.css— y va
      centrado: la margen derecha libre es (ancho - 1040) / 2. El índice va
      FUERA de esa franja y su ancho se ajusta a la margen que queda, así que
      no puede solaparse con el contenido por muy ancha que sea la figura.
    */
    --band: 1040px;
    --gap: 0.75rem;
    --toc-width: 13rem;
    position: fixed;
    top: 5.5rem;
    left: calc(50% + var(--band) / 2 + var(--gap));
    width: min(var(--toc-width), calc(50% - var(--band) / 2 - var(--gap) * 2));
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    display: none;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /*
    La margen derecha necesita 520 (media franja) + índice + 2 × respiro:
    a partir de 1360 px el índice ya tiene sitio (y sale de 13 rem, su
    ancho de diseño, a partir de 1520 px). Por debajo se estrecha con la
    margen, nunca se solapa.
  */
  @media (min-width: 1360px) {
    .toc {
      display: block;
    }
  }

  /* Margen estrecha: cuerpo más pequeño para que los títulos quepan. */
  @media (min-width: 1360px) and (max-width: 1519px) {
    .toc {
      font-size: 0.74rem;
    }
  }

  .toc-inline {
    margin: 0 0 32px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg2);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .toc-inline .toc-title {
    margin: 0;
  }

  .toc-inline__summary {
    cursor: pointer;
  }

  .toc-inline[open] .toc-inline__summary {
    margin-bottom: 0.8rem;
  }

  .toc-inline__link {
    color: var(--mut);
    text-decoration: none;
  }

  .toc-inline__link:hover {
    color: var(--a);
  }

  /* Con sitio para el índice lateral, el desplegable sobra. */
  @media (min-width: 1360px) {
    .toc-inline {
      display: none;
    }
  }

  .toc-title {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--mut);
    margin: 0 0 0.8rem 0;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-list li {
    margin: 0;
  }

  .toc-link {
    color: var(--mut);
    text-decoration: none;
    display: block;
    transition: color 0.15s;
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
  }

  .toc-link:hover {
    color: var(--a);
  }

  .toc-link.active {
    color: var(--a);
    border-left-color: var(--a);
    font-weight: 700;
  }
</style>

<script>
  let tocObserver: IntersectionObserver | null = null;

  function initToc() {
    tocObserver?.disconnect();
    tocObserver = null;

    const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
    if (!links.length) return;

    const headingIds = Array.from(links).map((l) => l.dataset.heading!);
    const headingEls = headingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    let current = "";

    tocObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            current = entry.target.id;
          }
        }
        links.forEach((l) => {
          l.classList.toggle("active", l.dataset.heading === current);
        });
      },
      { rootMargin: "-10% 0px -75% 0px" }
    );

    headingEls.forEach((el) => tocObserver!.observe(el));
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => {
    tocObserver?.disconnect();
    tocObserver = null;
  });
</script>
