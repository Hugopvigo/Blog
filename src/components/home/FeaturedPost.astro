---
import type { CollectionEntry } from "astro:content";
import Snippet from "../Snippet.astro";
import {
  postHref,
  postSlug,
  resolveSnippet,
  urlHost,
} from "../../lib/content-utils";

export interface Props {
  /** El post destacado. Opcional: sin posts, el componente no pinta nada. */
  post?: CollectionEntry<"blog">;
}

const { post } = Astro.props;

// Un post externo vive en otra web: su enlace es su url y no tiene
// descripción (esa solo existe en la rama interna del esquema).
const href = post ? postHref(post) : "";
const snippet = post ? resolveSnippet(post) : null;
const external = post?.data.external === true;

// La descripción solo existe en la rama interna del esquema, y la etiqueta
// tiene que ser coherente con el enlace real: `cat <slug>.md` solo tiene
// sentido para un post interno; uno externo abre otra web.
let description: string | undefined;
let file = "";
if (post) {
  if (post.data.external === true) {
    file = `open ${urlHost(post.data.url)} →`;
  } else {
    description = post.data.description;
    file = `cat ${postSlug(post)}.md →`;
  }
}
---

{
  post && snippet && (
    <a
      class="featured"
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
    >
      <span class="featured__text">
        <span class="featured__label">// destacado</span>
        <span class="featured__title">{post.data.title}</span>
        {description && (
          <span class="featured__desc">{description}</span>
        )}
        <span class="featured__file">{file}</span>
      </span>

      <div class="featured__snippet">
        <Snippet snippet={snippet} size="md" />
      </div>
    </a>
  )
}

<style>
  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 18px;
    background: var(--bg2);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.2s, transform 0.2s;
  }

  .featured:hover {
    border-color: var(--a);
    transform: translateY(-3px);
  }

  .featured__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .featured__label {
    font-size: 13px;
    color: var(--b);
  }

  .featured__title {
    font-weight: 700;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .featured__desc {
    color: var(--mut);
  }

  .featured__file {
    color: var(--a-surface);
    font-weight: 700;
  }

  .featured__snippet {
    display: block;
    transform: rotate(1.5deg);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
</style>
