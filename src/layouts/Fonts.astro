---
/*
  Fuentes locales (Fontsource): sin CDN de Google.
  Solo los pesos que usa el diseño: JetBrains Mono para la interfaz y los
  títulos, IBM Plex Sans para el cuerpo del artículo.
  Se importan los archivos `latin-*`: los subconjuntos cirílico, griego y
  vietnamita no se usan en un sitio en español y Vite los incrustaba en
  base64 en el CSS compartido (~29 KB en cada página).
*/
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-400-italic.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "@fontsource/jetbrains-mono/latin-800.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-400-italic.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
---
