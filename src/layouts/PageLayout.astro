---
/*
  Layout de todas las páginas. El body va a ancho completo: cada sección
  define su propio contenedor de 1240px (utilidad .container).

  Props:
    promptPath  ruta que se muestra en el prompt-logo de la cabecera
    progress    muestra la barra de progreso de lectura (artículos)
  Slots:
    meta        metadatos de la página (<head>)
    main        contenido
    fixed       elementos fijos (índice, volver arriba)
*/
import "../styles/global.css";

import Fonts from "./Fonts.astro";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_LANG } from "../config";

export interface Props {
  promptPath?: string;
  progress?: boolean;
}

const { promptPath = "~", progress = false } = Astro.props;
---

<!DOCTYPE html>
<html class="dark" lang={SITE_LANG}>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content="Astro" />
    <Favicon />
    <slot name="meta" />
    <Fonts />
    <ThemeScript />
    <ClientRouter />
  </head>

  <body>
    <Header promptPath={promptPath} progress={progress} />
    <main id="main">
      <slot name="main" />
    </main>
    <slot name="fixed" />
    <Footer />
  </body>
</html>
