---
import { render } from "astro:content";
import BlogPostMeta from "../../components/BlogPostMeta.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { SITE_URL } from "../../config";
import {
  getPublishedPosts,
  getReadingTime,
  extractHeadings,
  postSlug,
  relatedPosts,
} from "../../lib/content-utils";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const internal = posts.filter((entry) => !entry.data.external);

  return internal.map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const frontmatter = entry.data;
const slug = postSlug(entry);
const readingTime = getReadingTime(entry.body ?? "");
const headings = extractHeadings(entry.body ?? "");

const posts = await getPublishedPosts();
const related = relatedPosts(entry, posts, 3);

// La OG de cada post: la que venga en el frontmatter o, si no hay, la
// primera imagen del cuerpo.
const firstImage = (body: string): string | undefined =>
  body.match(/!\[[^\]]*\]\(([^)\s]+)/)?.[1];

const ogImagePath =
  frontmatter.ogImagePath ?? firstImage(entry.body ?? "");
const ogImageAbsoluteUrl = ogImagePath
  ? new URL(ogImagePath, SITE_URL).toString()
  : undefined;
---

<ContentLayout
  entry={entry}
  readingTime={readingTime}
  headings={headings}
  related={related}
>
  <BlogPostMeta
    title={frontmatter.title}
    description={frontmatter.external ? undefined : frontmatter.description}
    publishDate={frontmatter.date.toISOString()}
    pagePath={`/blog/${slug}`}
    ogImageAbsoluteUrl={ogImageAbsoluteUrl}
    slot="meta"
  />
  <Content slot="content" />
</ContentLayout>
