---
import PageLayout from "../layouts/PageLayout.astro";
import PageMeta from "../components/PageMeta.astro";
import Prompt from "../components/Prompt.astro";
import FilterPills from "../components/FilterPills.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { PROJECT_TYPES, SITE_TITLE } from "../config";
import { getPublishedProjects } from "../lib/content-utils";

const projects = await getPublishedProjects();

// Las cuentas de las pastillas se calculan, no se escriben a mano.
const countOf = (type: string) =>
  projects.filter((project) => project.data.type === type).length;

const typeOptions = [
  { value: "*", label: `* ${projects.length}` },
  ...PROJECT_TYPES.map((type) => ({
    value: type,
    label: `${type.toLowerCase()} ${countOf(type)}`,
  })),
];
---

<PageLayout promptPath="~/proyectos">
  <PageMeta
    title={`Proyectos | ${SITE_TITLE}`}
    slot="meta"
    pagePath="/projects"
  />

  <header slot="main" class="head">
    <Prompt
      >ls ~/proyectos <span class="text-mut"
        ># {projects.length} proyectos, de noche</span
      ></Prompt
    >
    <h1 class="head__title">proyectos<span class="head__slash">/</span></h1>
    <p class="head__lead">
      Apps del tiempo, bots de Telegram y cosas que no le interesan a nadie más
      que a mí.
    </p>
  </header>

  <div slot="main" class="projects" data-filter-root data-filter-param="type">
    <div class="bar">
      <FilterPills label="Filtrar proyectos por tipo" options={typeOptions} />
      <span class="bar__count" data-filter-shown
        >{projects.length} de {projects.length}</span
      >
    </div>

    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</PageLayout>

<script>
  import { initFilterLists } from "../scripts/filter-list";
  initFilterLists();
</script>

<style>
  .head {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 104px) clamp(20px, 4vw, 40px) 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .head__title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(48px, 8vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .head__slash {
    color: var(--a);
  }

  .head__lead {
    margin: 0;
    max-width: 56ch;
    font-size: 17px;
    color: var(--mut);
    text-wrap: pretty;
  }

  .projects {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px) clamp(64px, 9vw, 112px);
  }

  /* La barra se pega bajo la cabecera solo en pantallas anchas. */
  .bar {
    display: flex;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 14px 0;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .bar {
      position: sticky;
      top: var(--header-h, 62px);
      z-index: 5;
    }
  }

  .bar__count {
    font-size: 14px;
    color: var(--mut);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    padding: clamp(32px, 5vw, 56px) 0 0;
  }
</style>
